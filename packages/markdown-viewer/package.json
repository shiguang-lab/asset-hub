{
  "name": "@shiguang/markdown-viewer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./toc": {
      "types": "./dist/toc.d.ts",
      "default": "./dist/toc.js"
