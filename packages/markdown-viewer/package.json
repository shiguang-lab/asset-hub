  },
  "dependencies": {
    "@shiguang/content": "workspace:*",
    "@shiguang2/components": "^0.1.5",
    "react": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "typescript": "catalog:"
  }
