# Shiguang Asset Hub 环境变量示例（开发模式默认值已内建，直接 pnpm dev 即可运行）

# ---- 通用 ----
NODE_ENV=development
LOG_LEVEL=info
DEV_AUTH=true                 # 开发模式：无 X-SG-Identity 时使用演示用户 dev-user
DEMO_SUBJECT=dev-user
DEMO_WORKSPACE_NAME=个人空间

# ---- 数据与对象存储 ----
DATA_DIR=.data
DATABASE_PATH=.data/shiguang.db
# 生产目标：NAS 专用 PostgreSQL + pgvector 实例（独立 asset_hub 库/角色）；切换前需完成 SQLite→PostgreSQL 数据层迁移。
# DATABASE_URL=postgres://asset_hub:CHANGE_ME@100.87.115.78:5433/asset_hub
OBJECT_STORE_DIR=.data/objects
SEED_DEMO=true

# ---- 事件总线（共享 NAS NATS，subject 前缀 asset_hub.* 隔离）----
# NATS_URL=nats://100.87.115.78:4222

# ---- 统一身份（access-gateway 注入 X-SG-Identity，RS256/JWKS 校验，同 OPC）----
# Web 与 OPC 共用 auth-service 的 HttpOnly session；未登录直接跳转统一 OAuth 登录页。
# VITE_UNIFIED_LOGIN_ORIGIN=https://shiguanglab.com
# ASSET_HUB_AUTH_TARGET=https://shiguanglab.com  # 仅 Vite 本地代理使用
# 本地真实账号模式：凭据只由 Vite(Node)读取，浏览器代码不可见；改账号后重启 Web。
# 开启后 Web 强制监听 127.0.0.1，并把线上签发的短时身份断言注入本地 API/SSE/上传下载请求。
# ASSET_HUB_LOCAL_BROKER_ENABLED=true
# ASSET_HUB_LOCAL_AUTH_USERNAME=
# ASSET_HUB_LOCAL_AUTH_PASSWORD=
# ASSET_HUB_LOCAL_API_TARGET=http://localhost:3001
# SG_IDENTITY_ISSUER=https://shiguanglab.com
# SG_IDENTITY_AUDIENCE=asset-hub-api
# SG_IDENTITY_ENTITLEMENT=asset-hub:access
# SG_IDENTITY_JWKS_URL=https://shiguanglab.com/.well-known/sg-identity-jwks.json
# SG_IDENTITY_JWKS_FILE=

# ---- API ----
PORT=3001
PUBLIC_API_BASE=http://localhost:3001
PUBLIC_GATEWAY_BASE=http://localhost:3004
WEB_BASE=http://localhost:3000

# ---- Worker ----
API_INTERNAL_BASE=http://localhost:3001
WORKER_TOKEN=dev-worker-token
WORKER_POLL_INTERVAL_MS=1500
WORKER_MAX_CONCURRENT=4
WORKER_STATE_PATH=.data/worker-state.db

# ---- Hatchet（可选：与 OPC 共用同一 engine，需为 asset-hub 单独创建 tenant 并生成 token）----
# 未配置 HATCHET_CLIENT_TOKEN 时，worker 回退到本地 outbox 轮询，不影响全流程运行。
# HATCHET_ENABLED=false
# HATCHET_CLIENT_TOKEN=
# HATCHET_CLIENT_TLS_STRATEGY=none
# HATCHET_CLIENT_HOST_PORT=localhost:7077   # gRPC 地址；与 OPC 共享 engine 时指向宿主机发布端口
# HATCHET_CLIENT_API_URL=http://localhost:8888
# HATCHET_WORKER_NAME=asset-hub-worker
# HATCHET_WORKER_LABELS={"product":"asset-hub"}
# HATCHET_WORKFLOW_PREFIX=asset-hub

# ---- Compute Worker ----
COMPUTE_PORT=3002
COMPUTE_TOKEN=dev-compute-token
COMPUTE_TEMP_DIR=.data/compute-tmp

# ---- Public Gateway ----
PUBLIC_GATEWAY_TOKEN=dev-gateway-token
PUBLISH_HMAC_SECRET=dev-publish-secret
# 公开页识别登录用户时，把 /api/auth/session 代理到统一认证（仅本地 dev 生效；生产由 access-gateway 处理）。
# 默认与 Vite 的 ASSET_HUB_AUTH_TARGET 一致；本地 broker 模式请指向 Web dev 服务（broker 中间件所在）。
# AUTH_BASE_URL=https://shiguanglab.com
# AUTH_BASE_URL=http://localhost:3000

# ---- AI（可选：接入平台 model-gateway；不配置则使用内置确定性本地模型，全流程仍可运行）----
# MODEL_GATEWAY_URL=http://100.87.115.78:3150
# MODEL_GATEWAY_API_KEY=
# MODEL_GATEWAY_MODEL=doubao-seed-2.0-lite
# MODEL_GATEWAY_STREAM_FIRST_BYTE_TIMEOUT_MS=600000
# MODEL_GATEWAY_STREAM_IDLE_TIMEOUT_MS=600000
# MODEL_GATEWAY_STREAM_TOTAL_TIMEOUT_MS=3600000
# MODEL_GATEWAY_MAX_OUTPUT_TOKENS=32768
# AI_FALLBACK_TO_LOCAL=true

# ---- 动态能力（可选：Skill / MCP 网关；不配置则 Agent 跳过能力注入）----
# SKILL_GATEWAY_URL=http://100.87.115.78:3110/api
# SKILL_GATEWAY_TOKEN=dev-token   # 生产请改用 OPC 的 service token
# MCP_GATEWAY_URL=http://100.87.115.78:3140
# MCP_GATEWAY_TOKEN=
# CAPABILITY_AGENT_ID=asset-hub

# ---- 生产环境切换 ----
# NODE_ENV=production
# DEV_AUTH=false
# ---- 对象存储（共享 OPC SeaweedFS S3 网关，独立 bucket/credential）----
# S3_ENDPOINT=http://100.87.115.78:8333
# S3_BUCKET=asset-hub
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
