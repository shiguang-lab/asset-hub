# Docker Compose deployment metadata. Runtime secrets are generated by
# prepare-runtime-env.sh and must never be committed.
NAS_BIND_IP=100.87.115.78
# Compose env file containing production database/object-store/model credentials.
ASSET_HUB_APP_ENV_FILE=./app.env
# GitHub Actions publishes these tags to GHCR on version-tag pushes only.
# Pin to a release tag (vX.Y.Z or X.Y.Z) or sha-<commit> for rollback.
IMAGE_TAG=latest
WEB_DEBUG_PORT=3700
API_DEBUG_PORT=3701
COMPUTE_DEBUG_PORT=3702
PUBLIC_GATEWAY_DEBUG_PORT=3704

INTERNAL_TOKEN=
WORKER_TOKEN=
COMPUTE_TOKEN=
PUBLIC_GATEWAY_TOKEN=
PUBLISH_HMAC_SECRET=
